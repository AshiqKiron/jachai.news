NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Internal admin UI at /admin (server-only — never NEXT_PUBLIC_)
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=  # optional; defaults to ADMIN_PASSWORD
# ADMIN_API_KEY=         # must match backend ADMIN_API_KEY when set
# INGEST_API_KEY=        # server-only; for Run ingest from /admin

# Sentry (optional — omit for local dev)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=  # CI only — upload source maps

# Supabase — auth + planned subscription/payment records
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Preview Pro-gated routes locally (browse full archive) before Supabase entitlements
# NEXT_PUBLIC_MOCK_PRO=true

# bKash Tokenized Checkout (server-only when integrated; do not prefix with NEXT_PUBLIC_)
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v2/tokenized-checkout
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_CALLBACK_URL=http://localhost:3000/api/bkash/callback
