# Single-database setup — copy to backend/.env and fill secrets.
# Guide: docs/DATABASE.md

DATABASE_POOLER_URL=postgresql://postgres.xbadshfnetqzpvdavaef:YOUR_DB_PASSWORD@YOUR_REGION.pooler.supabase.com:6543/postgres
DATABASE_POOL_MODE=pgbouncer

SUPABASE_URL=https://xbadshfnetqzpvdavaef.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

REDIS_URL=redis://127.0.0.1:6379/0
INGEST_ASYNC_ENABLED=true
INGEST_SCHEDULER_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]

GROQ_API_KEY=
AI_PROVIDER=groq

# Optional object storage on same Supabase project (taken-down vault snapshots)
# OBJECT_STORAGE_BACKEND=supabase
# OBJECT_STORAGE_BUCKET=shorup-assets