DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jachai
CORS_ORIGINS=["http://localhost:3000"]
GROQ_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=groq
# Optional — protect POST /api/v1/ingest (omit for local dev)
INGEST_API_KEY=

# Optional — protect GET /api/v1/admin/* (set in production; frontend uses server-side only)
ADMIN_API_KEY=

# Monitoring (optional — leave blank for local dev)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0
# HEALTHCHECKS_INGEST_URL=https://hc-ping.com/your-check-uuid
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_NOTIFY_INGEST_SUCCESS=true
# TELEGRAM_ALERT_ON_SENTRY_ERROR=true
