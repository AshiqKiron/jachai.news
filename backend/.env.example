DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jachai
# Production: point at PgBouncer / Supavisor transaction pool (e.g. Supabase :6543 for auth DB only).
# DATABASE_POOLER_URL=postgresql+asyncpg://postgres:postgres@pooler.example:6543/jachai
# DATABASE_POOL_MODE=pgbouncer
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_RECYCLE_SECONDS=1800

# Redis — rate limits, Celery broker, queued RSS ingest (recommended in production)
# REDIS_URL=redis://localhost:6379/0
# INGEST_ASYNC_ENABLED=true
# INGEST_INTERVAL_MINUTES_DEFAULT=60
# INGEST_SCHEDULER_ENABLED=true

CORS_ORIGINS=["http://localhost:3000"]
GROQ_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=groq
# Optional — protect POST /api/v1/ingest (omit for local dev)
INGEST_API_KEY=

# Optional — protect GET /api/v1/admin/* (set in production; frontend uses server-side only)
ADMIN_API_KEY=

# Monitoring (optional — leave blank for local dev)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0
# HEALTHCHECKS_INGEST_URL=https://hc-ping.com/your-check-uuid
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_NOTIFY_INGEST_SUCCESS=true
# TELEGRAM_ALERT_ON_SENTRY_ERROR=true

# Object storage (exports, PDFs, screenshots — optional)
# OBJECT_STORAGE_BACKEND=none
# OBJECT_STORAGE_BACKEND=supabase
# OBJECT_STORAGE_BUCKET=jachai-assets
# OBJECT_STORAGE_PUBLIC_BASE_URL=https://your-project.supabase.co/storage/v1/object/public/jachai-assets
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Rate limiting (REDIS_URL recommended in production)
# REDIS_URL=redis://localhost:6379/0
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_VERIFY_ANON_PER_HOUR=5
# RATE_LIMIT_VERIFY_AUTH_PER_HOUR=30
# RATE_LIMIT_VERIFY_PRO_PER_HOUR=200

# Optional — tiered limits for signed-in / Pro users (server-only; never expose service role)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWT_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=

# Verification performance (optional)
# REDIS_URL=redis://localhost:6379/0
# SEMANTIC_CACHE_MIN_SIMILARITY=0.92
# VERIFICATION_JOB_TTL_SECONDS=86400
